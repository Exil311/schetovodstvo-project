# PostgreSQL connection string (use a dedicated non-superuser DB user in production)
DATABASE_URL=postgresql://dormsmaster_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/shchetovodstvo
DATABASE_SSL=false

# Session signing secret (REQUIRED, minimum 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM_HEX_SECRET

# Environment ('production' on hosting enables Secure cookies and disables legacy plaintext password upgrades)
NODE_ENV=production
PORT=3000

# Google Apps Script Web App integration (redeploy after adding API_SECRET to Script Properties)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_NEW_DEPLOYMENT_ID/exec
GOOGLE_SCRIPT_TOKEN=CHANGE_ME_MATCHES_APPS_SCRIPT_API_SECRET

# Optional: Google account credentials shown in the in-app Documentation tab (only to logged-in users)
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_ACCOUNT_PASSWORD=

# Optional: explicit paths to pg_dump / psql if not in system PATH
# PG_DUMP_PATH=/usr/bin/pg_dump
# PSQL_PATH=/usr/bin/psql
